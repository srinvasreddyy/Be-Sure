# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=

# Security Secrets (Generate random strong strings for production)
JWT_SECRET=super_secret_jwt_key_please_change
JWT_EXPIRE=30d

# UK Vehicle Data API
# Sign up at ukvehicledata.co.uk to get this
UK_VEHICLE_API_KEY=your_ukvd_api_key
# Verify this package name in your UKVD dashboard
UK_VEHICLE_PACKAGE=VehicleData

# Email Configuration (Gmail)
# Use App Password: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password